# Este monorepo mantém intencionalmente duas major versions de React em
# simultâneo (React 18 na app mobile/Expo, React 19 na app admin/Next.js).
# O hoist automático de pnpm para node_modules/.pnpm/node_modules (usado
# como fallback por ferramentas que fazem resolução por ancestor-walk,
# como o TypeScript) só consegue guardar UMA versão por nome de pacote —
# com duas versões de react/@types-react no workspace isso causa
# resolução ambígua e incorreta. Desativar esse hoist obriga cada pacote
# a resolver estritamente através do seu próprio grafo de dependências.
hoist-pattern[]=*
hoist-pattern[]=!react
hoist-pattern[]=!react-dom
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
