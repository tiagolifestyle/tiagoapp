# ─────────────────────────────────────────────────────────────
# TiagoLifeStyle — variáveis de ambiente (raiz, referência geral)
# Copia este ficheiro para .env em cada app (apps/mobile/.env e
# apps/admin/.env.local) com os prefixos corretos — ver os
# .env.example dentro de cada app.
#
# NUNCA colocar valores reais neste ficheiro nem fazer commit
# de ficheiros .env com segredos.
# ─────────────────────────────────────────────────────────────

# Supabase (criar projeto em https://supabase.com)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Apenas usado em Edge Functions / scripts de servidor — nunca expor ao cliente
SUPABASE_SERVICE_ROLE_KEY=

# Futuro: pagamentos (Fase 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Futuro: push notifications
EXPO_PUBLIC_PROJECT_ID=
